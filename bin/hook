#!/usr/bin/env python3
"""Claude Code hook entry point: pick a line to say, hand it off, return at once.

Runs under the system Python with the standard library only, so it starts in
tens of milliseconds. The speaking happens in a detached child
(`uv run claude-voice say`), so the hook never holds up the session. Silent
unless the session was started with CLAUDE_VOICE=1.
"""

import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))

from claude_voice.hook import enabled, text_for  # noqa: E402


def main() -> int:
    if not enabled():
        return 0
    try:
        event = json.load(sys.stdin)
        text = text_for(event)
    except Exception:  # a hook must never break the session
        return 0
    if not text:
        return 0

    try:
        child = subprocess.Popen(
            ["uv", "run", "--quiet", "--project", str(ROOT), "claude-voice", "say"],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        child.stdin.write(text.encode())
        child.stdin.close()
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
