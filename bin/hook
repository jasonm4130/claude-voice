#!/usr/bin/env python3
"""Hook entry point. Standard library only so it starts fast; speaking happens in a detached child."""

import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))

from claude_voice.hook import enabled, text_for  # noqa: E402


def main() -> int:
    if not enabled():
        return 0
    try:
        event = json.load(sys.stdin)
        text = text_for(event)
    except Exception:  # the hook must never fail the session
        return 0
    if not text:
        return 0

    try:
        child = subprocess.Popen(
            ["uv", "run", "--quiet", "--project", str(ROOT), "claude-voice", "say"],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        child.stdin.write(text.encode())
        child.stdin.close()
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
