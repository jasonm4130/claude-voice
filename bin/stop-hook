#!/usr/bin/env python3
"""Claude Code Stop hook: speak a short version of the reply, then return at once.

Standard library only, so it starts fast under the system Python. The speaking
runs in a detached child (`uv run claude-voice say`) so the hook never blocks
the session. It speaks only when CLAUDE_VOICE=1 is set in the environment that
launched `claude`, so headless runs and agent teammates stay quiet.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))

from claude_voice.spoken import spoken_text  # noqa: E402


def main() -> int:
    if os.environ.get("CLAUDE_VOICE") != "1":
        return 0
    try:
        event = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0
    if event.get("stop_hook_active"):
        return 0
    text = spoken_text(event.get("last_assistant_message") or "")
    if not text:
        return 0

    child = subprocess.Popen(
        ["uv", "run", "--quiet", "--project", str(ROOT), "claude-voice", "say"],
        stdin=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    child.stdin.write(text.encode())
    child.stdin.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
